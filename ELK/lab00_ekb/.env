STACK_VERSION=9.5.1             # Definisce la versione comune di Elasticsearch e Kibana utilizzata nel laboratorio.
CLUSTER_NAME=elastic-siem-lab   # Imposta il nome logico del cluster Elasticsearch.
ELASTIC_PASSWORD=ElasticLab2026 # Password didattica dell'utente amministrativo elastic.
KIBANA_PASSWORD=KibanaLab2026   # Password didattica dell'utente interno kibana_system.
ES_PORT=127.0.0.1:9200          # Espone Elasticsearch soltanto sull'interfaccia locale del computer.
KIBANA_PORT=5601                # Espone Kibana sulla porta 5601 del computer host.
MEM_LIMIT=4g                    # Limita a 4 GB la memoria utilizzabile da ciascun container principale.
